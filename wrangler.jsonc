{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mymap",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    // default html_handling: "/" → index.html, /video.html → 307 /video
    "directory": "site"
  },
  // MyMap.brightskyit.com → this worker (zone is on the same account,
  // so Cloudflare provisions DNS + TLS automatically)
  "routes": [
    {
      "pattern": "mymap.brightskyit.com",
      "custom_domain": true
    }
  ]
}
